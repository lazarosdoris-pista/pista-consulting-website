# Server Configuration
PORT=3001

# SMTP Email Configuration
# For Gmail: smtp.gmail.com
# For Outlook: smtp-mail.outlook.com
# For custom SMTP: your-smtp-server.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Recipient Email (where leads will be sent)
RECIPIENT_EMAIL=info@pista.consulting

# Note: For Gmail, you need to:
# 1. Enable 2-Factor Authentication
# 2. Generate an "App Password" at https://myaccount.google.com/apppasswords
# 3. Use the App Password as SMTP_PASS (not your regular password)

